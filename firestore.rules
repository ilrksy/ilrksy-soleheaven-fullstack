rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users rules - any logged-in user can read a profile (to see seller info); only the owner can write
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Listings rules - anyone signed in can read; sellers can write
    match /listings/{listingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Orders rules
    match /orders/{orderId} {
      allow read: if request.auth != null && (resource.data.buyerId == request.auth.uid || resource.data.sellerUid == request.auth.uid);
      allow write: if request.auth != null;
    }
    
    // Custom Requests rules
    match /customRequests/{requestId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Platform Treasury rules
    match /platform/{docId} {
      allow read, write: if request.auth != null;
    }

    // Chat rooms rules
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
      
      // Messages inside a chat room
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
